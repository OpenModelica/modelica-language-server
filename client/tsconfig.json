{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "types": ["node", "mocha"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "src/test"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
