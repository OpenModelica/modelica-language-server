{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": ["mocha", "node"],
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "out",
    "rootDir": "src",
    "esModuleInterop": true
  },
  "include": [
    "src",
    "src/util"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
